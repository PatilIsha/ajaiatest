{
  "name": "ajaia-docs",
  "version": "1.0.0",
  "description": "Lightweight collaborative document editor (Ajaia assignment)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\""
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "mammoth": "^1.13.0",
    "marked": "^18.3.0",
    "multer": "^2.5.0",
    "sanitize-html": "^2.18.2"
  },
  "devDependencies": {
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "supertest": "^7.3.2",
    "vite": "^6.4.1"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.40.0",
    "esbuild": "npm:esbuild-wasm@^0.25.0"
  }
}
